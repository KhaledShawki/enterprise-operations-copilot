  "devDependencies": {
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@eslint/js": "9.39.5",
    "angular-eslint": "22.1.0",
    "eslint": "9.39.5",
